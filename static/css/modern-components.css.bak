/* ============================================================
   backupctl v23 – keine Topbar, zweigeteiltes Layout
   Links: Sidebar-Panel. Rechts: Content mit Titel + Grid.
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

:root {
  --bg:       #111827;
  --sb:       #1f2937;
  --card:     #1f2937;
  --card-hi:  #283548;
  --sel:      #374151;
  --input-bg: #111827;

  --border:   rgba(255,255,255,0.0);
  --border-s: rgba(255,255,255,0.08);
  --border-i: rgba(255,255,255,0.12);

  --text:     #f9fafb;
  --text-2:   #9ca3af;
  --text-3:   #4b5563;

  --acc:      #c96442;
  --acc-dim:  rgba(201,100,66,0.15);
  --acc-bd:   rgba(201,100,66,0.32);

  --g:  #16a34a; --g-h: #15803d;
  --b:  #2563eb; --b-h: #1d4ed8;
  --r:  #dc2626; --r-h: #b91c1c;

  --err:    #ef4444;
  --err-bg: rgba(239,68,68,0.10);
  --err-bd: rgba(239,68,68,0.25);

  --font: 'Inter', ui-sans-serif, sans-serif;
  --mono: 'JetBrains Mono', ui-monospace, monospace;

  --rad:    8px;
  --rad-lg: 12px;
  --rad-xl: 16px;
  --t: 130ms;
  --ease: cubic-bezier(0.4,0,0.2,1);

  --sh:   0 4px 24px rgba(0,0,0,0.5);
  --sh-l: 0 8px 32px rgba(0,0,0,0.55);
  --sh-m: 0 16px 64px rgba(0,0,0,0.7);
}

/* Light mode */
.light-mode {
  --bg:       #f3f4f6;
  --sb:       #ffffff;
  --card:     #ffffff;
  --card-hi:  #f9fafb;
  --sel:      #e5e7eb;
  --input-bg: #f9fafb;
  --border-s: rgba(0,0,0,0.08);
  --border-i: rgba(0,0,0,0.12);
  --text:     #111827;
  --text-2:   #4b5563;
  --text-3:   #9ca3af;
  --sh:   0 4px 20px rgba(0,0,0,0.08);
  --sh-l: 0 8px 28px rgba(0,0,0,0.12);
}

/* ── Reset ── */
*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html,body {
  height:100%; font-family:var(--font);
  font-size:15px; line-height:1.55;
  background:var(--bg); color:var(--text);
  -webkit-font-smoothing:antialiased;
}
a { color:inherit; text-decoration:none; }
button { font-family:var(--font); cursor:pointer; }
input,select,textarea { font-family:var(--font); }
::-webkit-scrollbar { width:5px; }
::-webkit-scrollbar-track { background:transparent; }
::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.12); border-radius:99px; }
.light-mode ::-webkit-scrollbar-thumb { background:rgba(0,0,0,0.15); }

/* ══════════════════════════════════════
   LAYOUT – kein Topbar, volle Höhe
   ══════════════════════════════════════ */
.app-layout {
  display:flex;
  height:100vh;
  overflow:hidden;
}

/* ══════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════ */
#sidebar {
  width:210px; flex-shrink:0;
  background:var(--sb);
  box-shadow:var(--sh-l);
  display:flex; flex-direction:column;
  overflow-y:auto;
  z-index:10;
}

/* Logo-Block */
.sb-logo {
  display:flex; align-items:center; gap:9px;
  padding:20px 16px 16px;
  flex-shrink:0;
}
.sb-logo-icon {
  width:30px; height:30px; border-radius:var(--rad);
  background:var(--acc-dim); border:1px solid var(--acc-bd);
  display:flex; align-items:center; justify-content:center;
  color:var(--acc); flex-shrink:0;
}
.sb-logo-text {
  font-size:16px; font-weight:700;
  color:var(--text); letter-spacing:-0.02em;
}

/* Nav */
.nav-items {
  display:flex; flex-direction:column;
  padding:4px 8px; gap:2px; flex:1;
}
.nav-item {
  display:flex; align-items:center; gap:10px;
  padding:9px 10px; border-radius:var(--rad);
  font-size:14px; color:var(--text-2); font-weight:400;
  border:none; background:transparent;
  width:100%; text-align:left; cursor:pointer;
  transition:background var(--t) var(--ease), color var(--t) var(--ease);
}
.nav-item:hover  { background:var(--sel); color:var(--text); }
.nav-item.active { background:var(--sel); color:var(--text); font-weight:500; }
.nav-icon { width:16px; height:16px; flex-shrink:0; opacity:0.5; transition:opacity var(--t); }
.nav-item:hover .nav-icon,
.nav-item.active .nav-icon { opacity:1; }

/* Footer mit Divider + Dark/Light */
.sb-footer {
  padding:8px 8px 12px; flex-shrink:0;
}
.sb-divider {
  border:none; border-top:1px solid var(--border-s);
  margin:0 4px 8px;
}

/* ══════════════════════════════════════
   MAIN CONTENT
   ══════════════════════════════════════ */
.main-content {
  flex:1; overflow-y:auto;
  padding:28px 32px;
  background:var(--bg);
}

/* ══════════════════════════════════════
   PAGE HEADER – Titel + Neu-Button
   ══════════════════════════════════════ */
.page-header {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:22px;
}
.page-title {
  font-size:24px; font-weight:700;
  color:var(--text); letter-spacing:-0.025em;
}
/* Untertitel komplett ausgeblendet */
.page-subtitle { display:none; }

/* ══════════════════════════════════════
   BUTTONS
   ══════════════════════════════════════ */
.btn {
  display:inline-flex; align-items:center; gap:6px;
  padding:8px 16px; border-radius:var(--rad);
  font-size:14px; font-weight:500; font-family:var(--font);
  border:1px solid transparent; cursor:pointer;
  white-space:nowrap;
  transition:all var(--t) var(--ease);
}
.btn-primary { background:var(--b); color:#fff; border-color:var(--b); }
.btn-primary:hover { background:var(--b-h); border-color:var(--b-h); }
.btn-success { background:var(--g); color:#fff; border-color:var(--g); }
.btn-success:hover { background:var(--g-h); border-color:var(--g-h); }
.btn-danger  { background:var(--r); color:#fff; border-color:var(--r); }
.btn-danger:hover  { background:var(--r-h); border-color:var(--r-h); }
.btn-ghost {
  background:transparent; color:var(--text-2); border-color:var(--border-s);
}
.btn-ghost:hover { background:var(--sel); color:var(--text); }
.btn-sm { padding:5px 12px; font-size:13px; }

.btn-icon {
  width:34px; height:34px; padding:0; border-radius:var(--rad);
  background:transparent; border:1px solid transparent;
  display:inline-flex; align-items:center; justify-content:center;
  cursor:pointer; color:var(--text-3);
  transition:all var(--t) var(--ease);
}
.btn-icon:hover { background:var(--sel); border-color:var(--border-s); color:var(--text-2); }
.btn-icon.btn-icon-danger { color:var(--r); }
.btn-icon.btn-icon-danger:hover { background:var(--err-bg); border-color:var(--err-bd); }

/* ══════════════════════════════════════
   CARDS – kein Border, nur Shadow
   ══════════════════════════════════════ */
.ds-card {
  background:var(--card);
  border-radius:var(--rad-lg);
  padding:20px 22px;
  border:none;
  box-shadow:var(--sh);
  transition:background var(--t) var(--ease), box-shadow var(--t) var(--ease);
}
.ds-card:hover { background:var(--card-hi); box-shadow:var(--sh-l); }

.card-title {
  font-size:15px; font-weight:600;
  color:var(--text); letter-spacing:-0.01em; line-height:1.4;
}

/* ══════════════════════════════════════
   LIST GRID – 2 Spalten
   ══════════════════════════════════════ */
.ds-list-grid {
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:14px;
}

/* ══════════════════════════════════════
   META GRID
   ══════════════════════════════════════ */
.meta-grid {
  display:grid; grid-template-columns:auto 1fr;
  column-gap:8px; row-gap:4px;
  font-family:var(--mono); font-size:12.5px;
}
.meta-grid .meta-label {
  color:var(--text-3); white-space:nowrap;
  font-size:11px; letter-spacing:0.06em;
  text-transform:uppercase; font-weight:600;
}
.meta-grid .meta-label::after { content:':'; }
.meta-grid .meta-value {
  color:var(--text-2);
  overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
}

/* ══════════════════════════════════════
   TOGGLE
   ══════════════════════════════════════ */
.toggle-switch {
  position:relative; display:inline-block;
  width:38px; height:21px; border-radius:99px;
  cursor:pointer; flex-shrink:0; padding:0;
  transition:background var(--t), border-color var(--t);
}
.toggle-on  { background:var(--acc-dim); border:1px solid var(--acc-bd); }
.toggle-off { background:var(--sel);     border:1px solid var(--border-s); }
.toggle-knob {
  position:absolute; top:3px;
  width:13px; height:13px; border-radius:50%;
  transition:left var(--t), background var(--t);
  pointer-events:none; display:block;
}
.toggle-on  .toggle-knob { left:calc(100% - 16px); background:var(--acc); }
.toggle-off .toggle-knob { left:3px; background:var(--text-3); }

/* ══════════════════════════════════════
   FORMS
   ══════════════════════════════════════ */
.form-group { display:flex; flex-direction:column; gap:6px; }
.form-label { font-size:13px; font-weight:600; color:var(--text-2); }
.required-mark { color:var(--err); margin-left:2px; }
.form-input,.form-select {
  background:var(--input-bg); border:1px solid var(--border-i);
  border-radius:var(--rad); padding:9px 12px;
  font-size:14px; color:var(--text); width:100%;
  transition:border-color var(--t), box-shadow var(--t);
}
.form-input::placeholder { color:var(--text-3); }
.form-input:hover,.form-select:hover { border-color:rgba(255,255,255,0.20); }
.form-input:focus,.form-select:focus {
  outline:none; border-color:var(--b);
  box-shadow:0 0 0 3px rgba(37,99,235,0.18);
}
.form-input.is-invalid,.form-select.is-invalid {
  border-color:var(--err); box-shadow:0 0 0 3px var(--err-bg);
}
.form-checkbox { width:15px; height:15px; accent-color:var(--b); cursor:pointer; }
.form-select {
  appearance:none;
  background-image:url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%239ca3af' stroke-width='2'%3e%3cpolyline points='6,9 12,15 18,9'/%3e%3c/svg%3e");
  background-repeat:no-repeat; background-position:right 10px center;
  background-size:14px; padding-right:32px;
}
.form-error { font-size:12px; color:var(--err); font-family:var(--mono); display:none; margin-top:3px; }
.form-error.visible { display:block; }

/* ══════════════════════════════════════
   MODALS
   ══════════════════════════════════════ */
.ds-modal-backdrop {
  position:fixed; inset:0;
  background:rgba(0,0,0,0.65); backdrop-filter:blur(6px);
  display:flex; align-items:center; justify-content:center;
  z-index:50; padding:16px;
}
.ds-modal {
  background:var(--card); border:1px solid var(--border-s);
  border-radius:var(--rad-xl); box-shadow:var(--sh-m);
  width:100%; max-width:860px; max-height:90vh; overflow-y:auto;
  padding:28px 32px;
}
.ds-modal-title {
  font-size:16px; font-weight:700; color:var(--text);
  letter-spacing:-0.01em; text-align:center;
  margin-bottom:22px; padding-bottom:16px;
  border-bottom:1px solid var(--border-s);
  display:flex; align-items:center; justify-content:center; gap:8px;
}
.confirm-dialog {
  background:var(--card); border:1px solid var(--border-s);
  border-radius:var(--rad-xl); box-shadow:var(--sh-m);
  padding:28px 32px; width:100%; max-width:400px;
}
.confirm-icon {
  width:44px; height:44px; border-radius:50%;
  background:var(--err-bg); border:1px solid var(--err-bd);
  display:flex; align-items:center; justify-content:center;
  margin:0 auto 14px; color:var(--err);
}

/* ══════════════════════════════════════
   MISC
   ══════════════════════════════════════ */
.tab-content { min-height:200px; }
.htmx-indicator { display:none; }
.empty-state { grid-column:1/-1; text-align:center; padding:60px 20px; color:var(--text-3); }
.empty-state svg { margin:0 auto 12px; display:block; opacity:0.15; }
.empty-state-title { font-size:14px; font-weight:600; color:var(--text-2); }
.empty-state-sub { font-size:13px; margin-top:4px; }

/* ══════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════ */
@media (max-width:900px) {
  .ds-list-grid { grid-template-columns:1fr; }
}
@media (max-width:768px) {
  #sidebar {
    position:fixed; top:0; left:0; bottom:0; z-index:40;
    transform:translateX(-100%);
    transition:transform 260ms var(--ease);
  }
  #sidebar.mobile-open { transform:translateX(0); }
  .main-content { padding:16px 18px; }
}
