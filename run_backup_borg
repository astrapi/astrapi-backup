#!/usr/bin/env python3
import subprocess, json

def get_vm_list():
    cmd = [
        "ssh", "backupadm@proxmox01.simpsons.lan",
        "sudo", "pvesh", "get", "/cluster/resources",
        "--type", "vm", "--output-format", "json"
    ]
    result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    data = json.loads(result.stdout)
    vm_list = []
    for vm in data:
        if vm.get("tags") and "borg" in vm["tags"]:
            vm_list.append((vm["vmid"], vm["name"]))
    return vm_list

def get_borgmatic_list(host: str):
    """
    Liefert alle Borgmatic-Konfigurationsdateien mit dem Schema 'backup0*.yaml'
    vom angegebenen Host zurück.
    """
    cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=30",
        f"backupadm@{host}",
        "ls /var/lib/backupadm/.borgmatic/backup0*.yaml 2>/dev/null"
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        files = result.stdout.strip().splitlines()
        return files
    except subprocess.CalledProcessError:
        return []

def run_borgmatic(host: str, config: str):
    """
    Führt borgmatic mit der angegebenen Config-Datei auf dem Host aus.
    """
    cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=30",
        f"backupadm@{host}",
        f"/var/lib/backupadm/.venv/bin/borgmatic --config {config}"
    ]
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        print(f"[OK] Borgmatic auf {host} mit {config} gestartet.")
        return True, result.stdout
    except subprocess.CalledProcessError as e:
        print(f"[FEHLER] Borgmatic auf {host} mit {config}: {e.stderr}")
        return False, e.stderr

def run_rsync_jobs():
    """
    Führt definierte rsync-Jobs aus, um Repos zwischen Hosts/Storages zu synchronisieren.
    """
    jobs = [
        # → Backup02 intern
        ("/storage/borg/dms/", "backup02:/storage/borg/dms/"),
        ("/storage/borg/cloud/", "backup02:/storage/borg/cloud/"),

        # → Backup03 intern
        ("/storage/borg/dms/", "backup03:/storage/borg/dms/"),
        ("/storage/borg/cloud/", "backup03:/storage/borg/cloud/"),
    ]

    print("\n=== Starte rsync-Jobs ===")
    results = []
    for src, dst in jobs:
        cmd = ["rsync", "-av", "--delete", "--itemize-changes", src, dst]
        print(f"→ Sync: {src} → {dst}")
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode == 0:
            print(f"[OK] {src} → {dst}")
            results.append((src, dst, True))
        else:
            print(f"[FEHLER] {src} → {dst}")
            print(result.stderr)
            results.append((src, dst, False))

    print("\n=== Zusammenfassung rsync ===")
    for src, dst, success in results:
        status = "✔ Erfolgreich" if success else "✘ Fehler"
        print(f"{src} → {dst}\t{status}")

def run_rsync_extern_jobs():
    """
    Führt externe rsync-Jobs aus, indem per ssh -A auf Host A eingeloggt wird
    und dort ein rsync zu Host B gestartet wird.
    """
    jobs = [
        # Quelle liegt auf backup02, Ziel auf backup02
        ("backup02.simpsons.lan", "/storage/borg/dms/", "/storage_extern/borg/dms/"),
        ("backup02.simpsons.lan", "/storage/borg/cloud/", "/storage_extern/borg/cloud/"),
        ("backup02.simpsons.lan", "/storage/borg/nfs1/", "/storage_extern/borg/nfs1/"),
        ("backup02.simpsons.lan", "/storage/borg/nfs2/", "/storage_extern/borg/nfs2/"),
    ]

    print("\n=== Starte externe rsync-Jobs ===")
    results = []
    for src_host, src_path, dst in jobs:
        cmd = [
            "ssh", src_host,
            "rsync", "-av", "--delete", "--itemize-changes",
            src_path, dst
        ]
        print(f"→ Sync: {src_host}:{src_path} → {dst}")
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode == 0:
            print(f"[OK] {src_host}:{src_path} → {dst}")
            results.append((src_host, src_path, dst, True))
        else:
            print(f"[FEHLER] {src_host}:{src_path} → {dst}")
            print(result.stderr)
            results.append((src_host, src_path, dst, False))

    print("\n=== Zusammenfassung externe rsync-Jobs ===")
    for src_host, src_path, dst, success in results:
        status = "✔ Erfolgreich" if success else "✘ Fehler"
        print(f"{src_host}:{src_path} → {dst}\t{status}")

def main():
    vms = get_vm_list()
    print("Gefundene CT/VM mit Tag 'borg':")
    results = []
    for vmid, name in vms:
        print(f"{vmid}\t{name}")
        configs = get_borgmatic_list(name)
        if configs:
            for cfg in configs:
                print(f"   ↳ {cfg}")
                success, output = run_borgmatic(name, cfg)
                results.append((vmid, name, cfg, success))
        else:
            print("   ↳ keine Configs gefunden")
            results.append((vmid, name, None, False))

    # Zusammenfassung Borgmatic
    print("\n=== Zusammenfassung Borgmatic ===")
    for vmid, name, cfg, success in results:
        if cfg:
            status = "✔ Erfolgreich" if success else "✘ Fehler"
            print(f"{vmid}\t{name}\t{cfg}\t{status}")
        else:
            print(f"{vmid}\t{name}\tkeine Configs")

    # anach rsync-Jobs starten
    run_rsync_jobs()
    run_rsync_extern_jobs()

if __name__ == "__main__":
    main()
